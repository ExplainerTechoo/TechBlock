{
  "name": "techblock",
  "version": "1.0.0",
  "description": "TechBlock - Focus, Website & App Blocker with Tasks by Kartik Chobdar / Explainer Techoo",
  "main": "src/main.js",
  "author": "Kartik Chobdar / Explainer Techoo",
  "license": "All rights reserved",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "ExplainerTechoo",
        "repo": "TechBlock"
      }
    ],
    "appId": "com.explainertechoo.techblock",
    "productName": "TechBlock",
    "copyright": "Copyright © Kartik Chobdar / Explainer Techoo. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}
