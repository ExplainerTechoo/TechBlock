# Environment variables example
# Copy this file to .env and fill in your actual values
# .env is gitignored for security - never commit real .env to GitHub

# Supabase Authentication
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Admin Access (for admin block features)
# These are required for admin:getAnalytics and admin:verify IPC handlers
ADMIN_EMAILS=admin@example.com
ADMIN_MASTER_PASSWORD=your-secure-password-here

# Optional: Bypass admin elevation requirement (for testing without Admin rights)
TECHBLOCK_NO_ELEVATE=1